        "# Create a copy of original dataset\n",
        "clean_df = df.copy()\n",
        "\n",
        "# 1. Remove duplicate records\n",
        "clean_df.drop_duplicates(inplace=True)\n",
        "\n",
        "# 2. Convert numerical columns into numeric data types\n",
        "numeric_columns = ['Age', 'Attendance', 'Exam_Score']\n",
        "\n",
        "for col in numeric_columns:\n",
        "    clean_df[col] = pd.to_numeric(clean_df[col], errors='coerce')\n",
        "\n",
        "# 3. Replace invalid values with NaN\n",
        "clean_df.loc[~clean_df['Age'].between(16, 60), 'Age'] = np.nan\n",
        "\n",
        "clean_df.loc[\n",
        "    ~clean_df['Attendance'].between(0, 100),\n",
        "    'Attendance'\n",
        "] = np.nan\n",
        "\n",
        "clean_df.loc[\n",
        "    ~clean_df['Exam_Score'].between(0, 100),\n",
        "    'Exam_Score'\n",
        "] = np.nan\n",
        "\n",
        "# 4. Handle missing numerical values using median\n",
        "for col in numeric_columns:\n",
        "    clean_df[col] = clean_df[col].fillna(clean_df[col].median())\n",
        "\n",
        "# 5. Handle missing categorical values using mode\n",
        "clean_df['Department'] = clean_df['Department'].fillna(\n",
        "    clean_df['Department'].mode()[0]\n",
        ")\n",
        "\n",
        "# 6. Standardize categorical values\n",
        "clean_df['Department'] = (\n",
        "    clean_df['Department']\n",
        "    .astype(str)\n",
        "    .str.strip()\n",
        "    .str.lower()\n",
        ")\n",
        "\n",
        "# Make department names consistent\n",
        "department_mapping = {\n",
        "    'computer': 'Computer',\n",
        "    'ce': 'CE',\n",
        "    'electronics': 'Electronics',\n",
        "    'it': 'IT'\n",
        "}\n",
        "\n",
        "clean_df['Department'] = clean_df['Department'].replace(\n",
        "    department_mapping\n",
        ")\n",
        "\n",
        "print(\"Data cleaning completed successfully!\")"
